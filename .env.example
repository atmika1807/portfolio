# Copy to .env.local (never commit it). On Vercel, add the same names under Settings > Environment Variables.
# Without a key the "Ask my portfolio" box still works: it quotes the best passages instead of writing an answer.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5 (fast and cheap).
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional limits (defaults shown)
ASK_PER_IP=8          # questions per visitor per 10 minutes
ASK_DAILY_CAP=300     # questions per day across all visitors, then it falls back to quoting passages
